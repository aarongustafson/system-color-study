{
  "name": "system-color-study",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && node scripts/serve.js --dist",
    "capture:local": "node scripts/capture-local.js",
    "submit": "node scripts/submit.js",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9"
  }
}
